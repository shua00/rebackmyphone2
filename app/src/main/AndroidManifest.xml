<?xml version="1.0" encoding="utf-8"?>
<!-- 
======================================================================
  AndroidManifest.xml 修改记录 (2026-11-04)
  1. 新增 FOREGROUND_SERVICE_DATA_SYNC 权限，适配 Android 14+ 降级机制。
  2. TrackingService 增加 dataSync 前台类型，防止 Android 14+ 降级时闪退。
  3. 移除 NEARBY_WIFI_DEVICES 的 neverForLocation 标记，防止极端情况下 BSSID 被系统脱敏。
======================================================================
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.devicefinder">

    <!-- 基础网络与定位 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    
    <!-- UDP 广播/组播本地自救所必须的 Multicast 权限 (20261103) -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    
    <!-- ★ [修复] 2026-11-04 移除 neverForLocation，确保后台 WiFi 扫描结果不被系统沙盒强制脱敏（保障后端 WiFi 定位准确） -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />
    
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    
    <!-- 动态启用/禁用组件（隐藏图标别名）必须声明的权限 -->
    <uses-permission android:name="android.permission.CHANGE_COMPONENT_ENABLED_STATE" />

    <!-- 前台服务与保活 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    
    <!-- ★ [修复] 2026-11-04 增补 Android 14+ 核心前台 dataSync 权限，对应 Java 代码 startForeground 失败时的容错降级 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    
    <!-- 运动传感器、短信、响铃 -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" /> 
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:label="系统安全服务"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">

        <!-- 核心追踪服务 -->
        <!-- ★ [修复] 2026-11-04 修改为 foregroundServiceType="location|dataSync"。
             完美适配 Java 层 startForeground 的 dataSync 降级机制，防止 Android 14+ 闪退 -->
        <service
            android:name=".TrackingService"
            android:enabled="true"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="location|dataSync" />

        <!-- 保活 JobService 声明 (20261104 13:27) -->
        <service
            android:name=".KeepAliveJobService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />

        <!-- 开机自启：移除 directBootAware，等待 BOOT_COMPLETED（解锁后触发） -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- 充电恢复 -->
        <receiver
            android:name=".PowerConnectedReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
            </intent-filter>
        </receiver>

        <!-- 低版本网络恢复广播（注：仅对 Android 7.0 以下生效，高版本由 NetworkCallback 接管） -->
        <receiver
            android:name=".LegacyNetworkReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.net.conn.CONNECTIVITY_CHANGE" />
            </intent-filter>
        </receiver>

        <!-- 设备管理器（防普通手段轻松卸载） -->
        <receiver
            android:name=".MyDeviceAdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- 短信指令接收器 -->
        <receiver
            android:name=".SmsReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- 拨号盘暗号入口：
             8866 主界面 / 7788 对讲机 / 5566 留言板 / 9900 强制上报
             5678 老人模式切换（★新增）/ 4321 设备自检（★新增） -->
        <receiver
            android:name=".DialerReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.provider.Telephony.SECRET_CODE" />
                <data android:scheme="android_secret_code" android:host="8866" />
                <data android:scheme="android_secret_code" android:host="7788" />
                <data android:scheme="android_secret_code" android:host="5566" />
                <data android:scheme="android_secret_code" android:host="9900" />
                <data android:scheme="android_secret_code" android:host="5678" />  <!-- ★ 老人模式切换 -->
                <data android:scheme="android_secret_code" android:host="4321" />  <!-- ★ 设备自检通知 -->
            </intent-filter>
        </receiver>

        <!-- 局域网聊天界面：adjustResize 顶起键盘，excludeFromRecents 防划死 -->
        <activity
            android:name=".ChatActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:excludeFromRecents="true" 
            android:taskAffinity="com.example.devicefinder.chat" />

        <!-- 权限引导主界面 -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- 桌面启动别名（供 LauncherIconUtils 动态显示/隐藏图标） -->
        <activity-alias
            android:name=".VisibleAliasActivity"
            android:enabled="true"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
